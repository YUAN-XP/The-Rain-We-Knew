  lines:
  - speaker: "\u6BCD\u4EB2"
    text: "\u662F\u6628\u5929\u521A\u642C\u6765\u7684\u90A3\u4E2A\u7537\u5B69\uFF1F\u624D\u8BA4\u8BC6\u4E00\u4E24\u5929\uFF0C\u5C31\u8FD9\u4E48\u719F\u4E86\u3002"
  - speaker: "\u7236\u4EB2"
    text: "\u5E73\u65F6\u53EB\u4F60\u51FA\u53BB\u8D70\u8D70\u90FD\u4E0D\u80AF\u3002\u4ECA\u5929\u8FC7\u751F\u65E5\uFF0C\u96BE\u5F97\u6709\u670B\u53CB\u6765\u7EA6\u3002"
  - speaker: "\u6BCD\u4EB2"
    text: "\u628A\u684C\u4E0A\u7684\u76F8\u673A\u5E26\u4E0A\u5427\uFF0C\u51FA\u53BB\u73A9\u968F\u4FBF\u62CD\u62CD\u3002"
  - speaker: "\u7236\u4EB2"
    text: "\u62FF\u7A33\u4E86\uFF0C\u522B\u6454\u574F\u3002\u665A\u996D\u524D\u56DE\u6765\u3002"
