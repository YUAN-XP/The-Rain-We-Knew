  m_Script: {fileID: 11500000, guid: 0c59465da9bc39243a973773784e853a, type: 3}
  m_Name: D_S03_RiverIntroduction
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\u8096\u9E4F"
    text: "\u6211\u4EEC\u5C31\u5728\u8FD9\u73A9\u8FC7\u4E00\u6B21\uFF0C\u600E\u4E48\u5C31\u53D8\u6210\u8001\u5730\u65B9\u4E86\u3002"
  - speaker: "\u7537\u5B69"
    text: "\u4EE5\u540E\u8FD8\u4F1A\u6765\u7684\u561B\uFF0C\u6211\u559C\u6B22\u8FD9\u3002"
  - speaker: "\u7537\u5B69"
    text: "\u5BF9\uFF0C\u4E0A\u6B21\u8DDF\u4F60\u8BF4\u6211\u7238\u7238\u7684\u65B0\u5409\u4ED6\uFF0C\u5C31\u662F\u8FD9\u4E2A\u3002"
  - speaker: "\u7537\u5B69"
    text: "\u5F39\u70B9\u4EC0\u4E48\u5462\u2026\u2026\u5965\u5BF9\uFF0C\u4ECA\u5929\u662F\u4F60\u7684\u751F\u65E5\uFF0C\u5C31\u5F39\u300A\u751F\u65E5\u5FEB\u4E50\u300B\u5427\u3002"
  - speaker: "\u8096\u9E4F"
    text: "\u4F60\u600E\u4E48\u77E5\u9053\u6211\u7684\u751F\u65E5\uFF1F"
  - speaker: "\u7537\u5B69"
    text: "\u6628\u5929\u6211\u4EEC\u521A\u642C\u8FC7\u6765\u7684\u65F6\u5019\u53BB\u4F60\u4EEC\u5BB6\u505A\u5BA2\uFF0C\u4F60\u5988\u5988\u8BF4\u7684\u3002"
  - speaker: "\u7537\u5B69"
    text: "\u5979\u4ECA\u65E9\u8FD8\u53EB\u6211\u4EEC\u4E00\u8D77\u53BB\u5403\u665A\u9910\u5462\u3002"
