  m_Script: {fileID: 11500000, guid: 0c59465da9bc39243a973773784e853a, type: 3}
  m_Name: D_S03_StoryEnd
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\u7FA4\u4F17"
    text: "\u8FD9\u4E48\u591A\u4EBA\u90FD\u8BF4\u5979\u6709\u95EE\u9898\uFF0C\u96BE\u9053\u5927\u5BB6\u8FD8\u80FD\u4E00\u8D77\u8BF4\u9519\uFF1F"
  - speaker: "\u9A91\u58EB"
    text: "\u4EBA\u591A\uFF0C\u5C31\u4E00\u5B9A\u662F\u5BF9\u7684\u5417\uFF1F"
  - speaker: "\u9A91\u58EB"
    text: "\u4E0D\u77E5\u9053\u3002\u6240\u4EE5\u624D\u5E94\u8BE5\u5148\u67E5\u6E05\u695A\u3002"
  - speaker:
    text: "\u9A91\u58EB\u7FFB\u67E5\u8D26\u672C\uFF0C\u53C8\u627E\u6765\u8F66\u592B\u3002\u539F\u6765\u7CAE\u98DF\u6309\u8001\u56FD\u738B\u7684\u547D\u4EE4\uFF0C\u9001\u5F80\u57CE\u5916\u53D7\u707E\u7684\u6751\u5E84\u3002"
  - speaker: "\u516C\u4E3B"
    text: "\u4F60\u521A\u624D\u4E0D\u6015\u4ED6\u4EEC\u8FDE\u4F60\u4E00\u8D77\u9A82\u5417\uFF1F"
  - speaker: "\u9A91\u58EB"
    text: "\u6015\u554A\u3002"
  - speaker: "\u9A91\u58EB"
    text: "\u53EF\u6015\u4E5F\u4E0D\u80FD\u88C5\u6CA1\u770B\u89C1\u3002"
  - speaker: "\u542C\u4E66\u5C45\u6C11"
    text: "\u53C8\u662F\u8FD9\u4E2A\u6545\u4E8B\uFF0C\u8001\u5957\u5566\u3002"
  - speaker:
    text: "\u2026\u2026\u90A3\u4E2A\u9A91\u58EB\u8FD8\u633A\u5E05\u7684\u3002"
  - speaker:
    text: "\u86EE\u52C7\u6562\u3002"
