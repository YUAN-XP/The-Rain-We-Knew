  lines:
  - speaker: "\u5411\u7131"
    text: "\u90D1\u6D9B\u8FD9\u5BB6\u4F19\u771F\u662F\u4E2A\u9EBB\u70E6\u4E8B\u3002"
  - speaker: "\u6768\u9A8F\u6C6A"
    text: "\u662F\u554A\uFF0C\u8FD8\u6709\u90A3\u4E2A\u8096\u9E4F\u3002\u5F97\u60F3\u4E2A\u529E\u6CD5\u628A\u4ED6\u4EEC\u62C6\u5F00\u3002"
  - speaker: "\u5411\u7131"
    text: "\u54B1\u4EEC\u4E0B\u5348\u662F\u4E0D\u662F\u6709\u8282\u4F53\u80B2\u8BFE\uFF1F"
  - speaker: "\u6768\u9A8F\u6C6A"
    text: "\u4F60\u662F\u60F3..."
  - speaker: "\u5411\u7131"
    text: "\u5618\uFF0C\u5F85\u4F1A\u51FA\u53BB\u8BF4\u3002"
  - speaker: "\u8096\u9E4F"
    text: "\u4ED6\u4EEC\u53C8\u5728\u8BA1\u5212\u4EC0\u4E48\uFF0C\u6211\u5F97\u62A2\u5728\u4ED6\u4EEC\u4E4B\u524D\u5148\u628A\u8FD9\u4E8B\u89E3\u51B3\u4E86\uFF0C\u8981\u4E0D\u7136\u6C38\u8FDC\u6CA1\u5B8C\u3002"
