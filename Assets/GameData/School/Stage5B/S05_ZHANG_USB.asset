  m_Script: {fileID: 11500000, guid: 0c59465da9bc39243a973773784e853a, type: 3}
  m_Name: S05_ZHANG_USB
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\u5F20\u82E5\u5A9B"
    text: "\u4F60\u6765\u4E86\uFF0C\u6211\u628AU\u76D8\u5E26\u8FC7\u6765\u4E86\uFF0C\u4F60\u786E\u5B9A\u60F3\u597D\u4E86\u5417\uFF1F"
  - speaker: "\u8096\u9E4F"
    text: "\u5BF9\uFF0C\u6211\u89C9\u5F97\u8001\u5E08\u5E94\u8BE5\u8981\u77E5\u9053\u8FD9\u4E9B\u4E8B\uFF0C\u4E0D\u80FD\u518D\u8BA9\u8FD9\u7FA4\u4EBA\u6B3A\u8D1F\u90D1\u6D9B\u4E86\u3002"
  - speaker: "\u5F20\u82E5\u5A9B"
    text: "\u884C\uFF0C\u5B89\u4FDD\u5BA4\u5728\u4E00\u697C\uFF0C\u4F60\u53EF\u4EE5\u7528\u7535\u8111\u53BB\u62F7\u4E00\u4EFD\u76D1\u63A7\u89C6\u9891\u5E26\u5230\u4E09\u697C\u53BB\u7ED9\u8001\u5E08\u3002"
  - speaker: "\u8096\u9E4F"
    text: "\u8C22\u4E86\uFF0C\u653E\u5B66\u8BF7\u4F60\u5403\u4E1C\u897F\u3002"
  - speaker: "\u5F20\u82E5\u5A9B"
    text: "\u6CA1\u4E8B\u513F\uFF0C\u6211\u65E9\u770B\u5411\u7131\u4E0D\u723D\u4E86\uFF0C\u5C31\u662F\u5BB6\u91CC\u6709\u70B9\u94B1\u7F62\u4E86\uFF0C\u5230\u5904\u6B3A\u8D1F\u8F6C\u6821\u751F\u3002\u5BF9\u4E86\uFF0C\u6211\u521A\u521A\u8DEF\u8FC7\u7684\u65F6\u5019\u597D\u50CF\u542C\u5230\u5411\u7131\u5728\u5395\u6240\u548C\u4ED6\u90A3\u8DDF\u73ED\u5728\u8BA8\u8BBA\u4EC0\u4E48\uFF0C\u4F60\u8981\u662F\u987A\u8DEF\u53EF\u4EE5\u8FC7\u53BB\u770B\u770B\u3002"
  - speaker: "\u8096\u9E4F"
    text: "\u8C22\u8C22\u3002"
