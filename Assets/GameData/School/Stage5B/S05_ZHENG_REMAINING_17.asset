  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0c59465da9bc39243a973773784e853a, type: 3}
  m_Name: S05_ZHENG_REMAINING_17
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u6211\u8FD9\u4E0D\u662F\u60F3\u8BA9\u4F60\u7684\u684C\u5B50\u66F4\u6709\u6807\u5FD7\u6027\u561B\u3002\u548C\u4F60\u4E00\u6837\uFF0C\u522B\u4EBA\u4E00\u773C\u5C31\u8BB0\u4F4F\u4F60\u773C\u89D2\u7684\u75E3\u4E86\u3002"
  - speaker: "\u8096\u9E4F"
    characterId: 2
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u968F\u4F60\u600E\u4E48\u8BF4\uFF0C\u8BA9\u6211\u523B\u5B8C\u5148\u3002"
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u8FD8\u633A\u8BB0\u4EC7\u3002\u5BF9\u4E86\uFF0C\u8FD9\u51E0\u6B21\u8C22\u8C22\u4F60\u5E2E\u6211\u89E3\u56F4\uFF0C\u4ED6\u4EEC\u8FD9\u4E9B\u4EBA\u771F\u662F\u65E0\u804A\u5230\u6CA1\u4E8B\u5E72\uFF0C\u5C31\u77E5\u9053\u6B3A\u8D1F\u6211\u8FD9\u79CD\u5916\u5730\u4EBA\u3002"
  - speaker: "\u8096\u9E4F"
    characterId: 2
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u6CA1\u5173\u7CFB\uFF0C\u4F60\u8981\u662F\u51FA\u4E8B\u4E86\u8C01\u8FD8\u966A\u6211\u73A9\u3002"
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u4F60\u8FD8\u662F\u548C\u4EE5\u524D\u4E00\u6837\uFF0C\u5B9E\u5728\u662F\u592A\u4ED7\u4E49\u4E86\u3002"
  - speaker: "\u8096\u9E4F"
    characterId: 2
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u4F60\u53C8\u77E5\u9053\u6211\u4EE5\u524D\u4E86\uFF1F\u6211\u5C0F\u65F6\u5019\u4E5F\u4E0D\u600E\u4E48\u7231\u8BF4\u8BDD\uFF0C\u4F46\u7ECF\u5E38\u542C\u5230\u52C7\u6562\u9A91\u58EB\u7684\u6545\u4E8B\uFF0C\u633A\u559C\u6B22\u3002"
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u4F60\u8FD8\u559C\u6B22\u62CD\u7167\u3002"
  - speaker: "\u8096\u9E4F"
    characterId: 2
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u4F60\u600E\u4E48\u77E5\u9053\uFF1F"
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u6211\u731C\u7684\uFF0C\u800C\u4E14\u4F60\u73B0\u5728\u8FD8\u5E26\u7740\u76F8\u673A\u5462\u3002"
  - speaker: "\u8096\u9E4F"
    characterId: 2
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u5C0F\u5FC3\u522B\u592A\u806A\u660E\u4E86\u3002"
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u662F\u5417\uFF0C\u6211\u5C0F\u65F6\u5019\u6709\u4E2A\u670B\u53CB\u4ED6\u4E5F\u559C\u6B22\u8FD9\u4E9B\u6545\u4E8B\u548C\u6444\u5F71\u3002\u540E\u6765\u6211\u642C\u8D70\u4E86\uFF0C\u4F30\u8BA1\u4ED6\u4E5F\u4E0D\u8BB0\u5F97\u4E86\u3002"
  - speaker: "\u8096\u9E4F"
    characterId: 2
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u90A3\u53EF\u4E0D\u4E00\u5B9A\u3002\u5BF9\u4E86\uFF0C\u6628\u5929\u4F60\u600E\u4E48\u88AB\u4ED6\u4EEC\u5173\u5728\u4F53\u80B2\u5668\u6750\u5BA4\u4E86\uFF1F"
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u8FD8\u4E0D\u662F\u4F60\uFF0C\u88AB\u76D7\u53F7\u4E86\u90FD\u4E0D\u77E5\u9053\u3002\u4ED6\u4EEC\u7528\u4F60QQ\u628A\u6211\u7EA6\u5230\u4F53\u80B2\u5668\u6750\u5BA4\u53BB\u4E86\u3002\u5FEB\u56DE\u53BB\u6362\u4E00\u4E2A\uFF0C\u522B\u518D\u7528\u81EA\u5DF1\u540D\u5B57\u9996\u5B57\u6BCD\u52A0\u4E0A\u751F\u65E5\u505A\u8D26\u53F7\u5BC6\u7801\u4E86\u3002"
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u4F60\u4EC0\u4E48\u5BC6\u7801\u90FD\u559C\u6B22\u7528\u540C\u4E00\u4E2A\u3002"
  - speaker: "\u8096\u9E4F"
    characterId: 2
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u90A3\u6211\u4E0B\u6B21\u8BBE\u7F6E\u5BC6\u7801\u628A\u4F60\u7684\u540D\u5B57\u4E5F\u52A0\u4E0A\u3002"
  - speaker: "\u90D1\u6D9B"
    characterId: 5
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u4F60\u6700\u597D\u662F\u3002\u9694\u58C1\u73ED\u5F20\u82E5\u5A9B\u597D\u50CF\u6709\u4E8B\u627E\u4F60\uFF0C\u4F60\u6709\u7A7A\u4E86\u8FC7\u53BB\u4E00\u73ED\u770B\u770B\u5427\u3002"
  - speaker: "\u8096\u9E4F"
    characterId: 2
    age: 0
    portraitMode: 0
    portraitKey: ""
    text: "\u884C\u3002"
