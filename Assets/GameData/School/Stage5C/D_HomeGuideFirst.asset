  m_Script: {fileID: 11500000, guid: 0c59465da9bc39243a973773784e853a, type: 3}
  m_Name: D_HomeGuideFirst
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: ???
    text: "\u4F60\u600E\u4E48\u6EE1\u5934\u5927\u6C57\u7684\uFF0C\u8FD8\u597D\u5427\uFF1F"
  - speaker: "\u8096\u9E4F"
    text: "\u8FD8\u597D\uFF0C\u5C31\u662F\u6709\u70B9\u4E0D\u597D\u3002\u5DEE\u70B9\u88AB\u9AD8\u4E2D\u8BB0\u5FC6\u91CC\u7684\u5C0F\u5B69\u6740\u4E86\u3002"
  - speaker: ???
    text: "\u6709\u65F6\u5019\u6211\u771F\u60F3\u597D\u597D\u6536\u62FE\u4ED6\u4E00\u987F\u3002"
  - speaker: "\u8096\u9E4F"
    text: "\u4F60\u8BA4\u8BC6\u4ED6\uFF1F"
  - speaker: ???
    text: "\u8BA4\u8BC6\uFF0C\u975E\u5E38\u8BA4\u8BC6\u3002\u597D\u4E86\uFF0C\u73B0\u5728\u4E0D\u662F\u8BF4\u8FD9\u4E2A\u7684\u65F6\u5019\uFF0C\u53BB\u4F11\u606F\u4E0B\u5427\uFF0C\u522B\u7D2F\u7740\u4E86\u3002"
