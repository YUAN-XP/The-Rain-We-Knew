  m_Name: F_CompleteNewspaper
  m_EditorClassIdentifier: Assembly-CSharp::FileData
  fileId: file_complete_newspaper
  fileName: "\u62FC\u5408\u540E\u7684\u62A5\u7EB8"
  summary: "\u4E09\u5F20\u6B8B\u7F3A\u7684\u62A5\u7EB8\u7EC8\u4E8E\u62FC\u5728\u4E86\u4E00\u8D77\u3002\u62A5\u9053\u63D0\u5230\uFF0C\u5468\u8FB9\u5730\u533A\u7684\u6BD2\u54C1\u6D3B\u52A8\u5DF2\u7ECF\u5F71\u54CD\u5230\u5C45\u6C11\u751F\u6D3B\uFF0C\u76F8\u5173\u8C03\u67E5\u4ECD\u5728\u7EE7\u7EED\u3002"
  content: "\u6BD2\u54C1\u6D3B\u52A8\u4FB5\u6270\u5468\u8FB9\u793E\u533A\uFF0C\u5C45\u6C11\u76FC\u6062\u590D\u5B89\u5B81\n\n\u8FD1\u6765\uFF0C\u5468\u8FB9\u5730\u533A\u63A5\u8FDE\u51FA\u73B0\u4E0E\u6BD2\u54C1\u6709\u5173\u7684\u6CBB\u5B89\u95EE\u9898\u3002\u539F\u672C\u5B89\u9759\u7684\u8857\u5DF7\u4E2D\uFF0C\u591C\u95F4\u4E89\u5435\u3001\u964C\u751F\u4EBA\u5458\u9891\u7E41\u51FA\u5165\u7B49\u60C5\u51B5\u9010\u6E10\u589E\u591A\uFF0C\u4E00\u4E9B\u5C45\u6C11\u5F00\u59CB\u63D0\u524D\u5173\u95E8\uFF0C\u5546\u94FA\u4E5F\u7F29\u77ED\u4E86\u8425\u4E1A\u65F6\u95F4\u3002\n\n\u5BF9\u4E0D\u5C11\u5BB6\u5EAD\u800C\u8A00\uFF0C\u53D8\u5316\u5E76\u4E0D\u662F\u4ECE\u4E00\u6B21\u4E25\u91CD\u4E8B\u4EF6\u5F00\u59CB\u7684\u3002\u6709\u4EBA\u8D77\u521D\u53EA\u662F\u7ECF\u5E38\u665A\u5F52\uFF0C\u968F\u540E\u5931\u53BB\u5DE5\u4F5C\u3001\u5411\u4EB2\u53CB\u501F\u94B1\uFF0C\u6700\u7EC8\u8FDE\u5BB6\u4E2D\u7684\u65E5\u5E38\u5F00\u652F\u4E5F\u96BE\u4EE5\u7EF4\u6301\u3002\u5BB6\u5C5E\u5F80\u5F80\u5728\u95EE\u9898\u5DF2\u7ECF\u96BE\u4EE5\u63A9\u76D6\u65F6\uFF0C\u624D\u610F\u8BC6\u5230\u53D1\u751F\u4E86\u4EC0\u4E48\u3002\n\n\u4E00\u540D\u4E0D\u613F\u900F\u9732\u59D3\u540D\u7684\u5C45\u6C11\u8BF4\uFF0C\u8FC7\u53BB\u5B69\u5B50\u4EEC\u653E\u5B66\u540E\u4F1A\u5728\u9644\u8FD1\u73A9\u5230\u5929\u9ED1\uFF0C\u5982\u4ECA\u5BB6\u957F\u603B\u4F1A\u53CD\u590D\u53EE\u5631\u4ED6\u4EEC\u65E9\u70B9\u56DE\u5BB6\u3002\u6BD4\u8D77\u65B0\u95FB\u91CC\u7684\u6848\u4EF6\uFF0C\u4EBA\u4EEC\u66F4\u76F4\u63A5\u611F\u53D7\u5230\u7684\uFF0C\u662F\u751F\u6D3B\u4E2D\u8D8A\u6765\u8D8A\u591A\u7684\u4E0D\u5B89\u3002\n\n\u76EE\u524D\uFF0C\u8B66\u65B9\u6B63\u5BF9\u76F8\u5173\u7EBF\u7D22\u5C55\u5F00\u8C03\u67E5\u3002\u90E8\u5206\u95EE\u9898\u5E76\u975E\u5C40\u9650\u4E8E\u67D0\u4E00\u5904\u573A\u6240\uFF0C\u6D89\u6848\u4EBA\u5458\u4E4B\u95F4\u7684\u8054\u7CFB\u4ECD\u6709\u5F85\u67E5\u660E\u3002\u5C45\u6C11\u5E0C\u671B\uFF0C\u8C03\u67E5\u80FD\u591F\u5C3D\u5FEB\u53D6\u5F97\u8FDB\u5C55\uFF0C\u8BA9\u8857\u9053\u91CD\u65B0\u6062\u590D\u5F80\u65E5\u7684\u5B89\u5B81\u3002\n\n\u2026\u2026\u62A5\u9053\u4E0B\u65B9\u5DF2\u7ECF\u7834\u635F\uFF0C\u540E\u7EED\u5185\u5BB9\u65E0\u6CD5\u8FA8\u8BA4\u3002"
  icon: {fileID: 7896310928490841032, guid: 5cdbc21edcd793945b4010c2285f1740, type: 2}
