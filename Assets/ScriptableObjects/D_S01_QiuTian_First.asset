  m_Script: {fileID: 11500000, guid: 0c59465da9bc39243a973773784e853a, type: 3}
  m_Name: D_S01_QiuTian_First
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Xiao Peng
    text: Who are you?
  - speaker: ???
    text: Can you still walk?
  - speaker: Xiao Peng
    text: I asked who you are.
  - speaker: ???
    text: Looks like you really don't remember anything.
  - speaker: Xiao Peng
    text: What?
  - speaker: Xiao Peng
    text: Where is this?
  - speaker: ???
    text: Somewhere you've always wanted to come back to.
  - speaker: Xiao Peng
    text: Me?
  - speaker: Xiao Peng
    text: Do we know each other?
  - speaker: ???
    text: At least I know you.
  - speaker: Xiao Peng
    text: Then tell me what happened.
  - speaker: ???
    text: You wouldn't believe me yet.
  - speaker: ???
    text: Go through that gate. You'll find what you forgot.
