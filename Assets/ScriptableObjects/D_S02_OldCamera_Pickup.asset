  m_Script: {fileID: 11500000, guid: 0c59465da9bc39243a973773784e853a, type: 3}
  m_Name: D_S02_OldCamera_Pickup
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 
    text: "柜子旁放着一台旧相机。"
  - speaker: 
    text: "机身已经有不少划痕，镜头却意外地保存得很好。"
  - speaker: 
    text: "拿在手里的瞬间，一种莫名的熟悉感从指尖传了上来。"
  - speaker: 
    text: "获得了关键物品「旧相机」。"
